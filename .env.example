# Confidior Engine: example environment file
#
# Copy to `.env` and fill in only the credentials you need.
# The engine loads this via python-dotenv when scripts fetch CVE feeds.
# The NVD feed (free, no credentials) works without any of these.

# OpenCVE credentials (required only for `confidior attacks sync --source opencve`).
# Note: OpenCVE's Bearer API token requires a paid plan (the free tier only
# exposes Basic Auth with username/password). Prefer Basic Auth unless you
# have a Pro/Business token.

# Basic Auth (works on the free tier).
OPENCVE_USERNAME=
OPENCVE_PASSWORD=

# Bearer token: paid plan only; leave blank if you set Basic Auth above.
OPENCVE_API_TOKEN=
